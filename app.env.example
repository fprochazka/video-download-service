# Settings of the video-download app container, copy to app.env (gitignored) and fill in; see README

# Gemini Developer API key from https://aistudio.google.com/apikey, transcription is off without it
GEMINI_API_KEY=
TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# Prices in USD per million tokens for the cost estimate, replacing the built-in ones of the models named; see README
#TRANSCRIPTION_PRICES='{"gemini-3.5-flash": {"input": 1.50, "output": 9.00, "as_of": "2026-11-01"}}'

# How many jobs run at the same time, the rest wait in the queue
#DOWNLOAD_CONCURRENCY=2
#TRANSCRIPTION_CONCURRENCY=2
# Recordings from 15 minutes are cut into chunks of about this many minutes, this many sent at once per transcription
#TRANSCRIPTION_CHUNK_MINUTES=5
#TRANSCRIPTION_CHUNK_CONCURRENCY=4

# Garbage collection of large old media
#GC_ENABLED=true
#GC_DRY_RUN=false
#GC_MAX_AGE_DAYS=90
#GC_MIN_SIZE_MB=5
#GC_INTERVAL_HOURS=6

# PUBLIC_BASE_URL, the URL in front of the file links of the MCP tools, is set in docker-compose.yml; it reads an
# override from the shell or from .env, not from this file
# More Host headers the /mcp endpoint accepts besides localhost and the host of PUBLIC_BASE_URL, comma-separated
#MCP_ALLOWED_HOSTS=
