# Settings of the video-download app container, copy to app.env (gitignored) and fill in; see README

# The transcription provider: gemini, elevenlabs or none (off, no key needed); the selected one needs its key below,
# the service does not start without it. See README
TRANSCRIPTION_PROVIDER=none
# Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ElevenLabs API key from https://elevenlabs.io/app/settings/api-keys, with access to Speech to Text
ELEVENLABS_API_KEY=
# The provider's model, its default when unset: gemini-3.5-flash-lite for gemini, scribe_v2 for elevenlabs
#TRANSCRIPTION_MODEL=
# Prices for the cost estimate, in USD per million tokens or per hour of audio, replacing the built-in ones of the
# models named; see README
#TRANSCRIPTION_PRICES='{"gemini-3.5-flash": {"input": 1.50, "output": 9.00, "as_of": "2026-11-01"}, "scribe_v2": {"per_hour": 0.22}}'

# How many jobs run at the same time, the rest wait in the queue
#DOWNLOAD_CONCURRENCY=2
#TRANSCRIPTION_CONCURRENCY=2
# Gemini: recordings from 7 minutes are cut into chunks of about this many minutes, this many sent at once per
# transcription
#TRANSCRIPTION_CHUNK_MINUTES=5
#TRANSCRIPTION_CHUNK_CONCURRENCY=4

# Garbage collection of large old media
#GC_ENABLED=true
#GC_DRY_RUN=false
#GC_MAX_AGE_DAYS=90
#GC_MIN_SIZE_MB=5
#GC_INTERVAL_HOURS=6

# The tailnet URL of the service. The MCP tools put it in front of their file links, and /mcp accepts its host in
# the Host header; without it /mcp answers a request through the tailnet with HTTP 421
#PUBLIC_BASE_URL=https://video-download.your-tailnet-name.ts.net
# More Host headers the /mcp endpoint accepts besides localhost and the host of PUBLIC_BASE_URL, comma-separated
#MCP_ALLOWED_HOSTS=
